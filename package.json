{
  "name": "sienra-gastos",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Expense and budget control for Clinica Veterinaria Sienra",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
